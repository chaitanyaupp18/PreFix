+
+/// PreFix (WIP, study reference): would splice a wrapper's body into its call
+/// sites instead of `call <alloc>_wrapper`. Currently only locates/logs them;
+/// the project does the inlining with --force-inline. See BinaryPasses.cpp.
+class ReplaceWrapperWithInst : public BinaryFunctionPass {
+private:
+  std::vector<std::string> Spec;
+
+  // Wrapper base name parsed from a "<function>:<wrapper>" spec chunk.
+  StringRef getWrapSymbol(const BinaryFunction &) const;
+
+public:
+  explicit ReplaceWrapperWithInst(const cl::opt<bool> &PrintPass,
+                                  cl::list<std::string> &Spec)
+      : BinaryFunctionPass(PrintPass), Spec(Spec) {}
+
+  bool staticID(const BinaryFunction &BF) const;
+
+  const char *getName() const override { return "replace-wrapper"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+/// PreFix core pass: at the call sites named on --replace-memalloc, repoint the
+/// call from <allocator> to <allocator>_wrapper. See BinaryPasses.cpp for the
+/// spec grammar and a walkthrough of the rewrite.
+class ReplaceMemAlloc : public BinaryFunctionPass {
+private:
+  std::vector<std::string> Spec;
+
+  // Parse the spec chunk for a function into { allocator -> {site indices} }.
+  std::map<std::string, std::set<size_t>> getLocalID(const BinaryFunction &) const;
+
+public:
+  explicit ReplaceMemAlloc(const cl::opt<bool> &PrintPass,
+                           cl::list<std::string> &Spec)
+      : BinaryFunctionPass(PrintPass), Spec(Spec) {}
+
+  // True if this function is named in the spec (cheap pre-filter).
+  bool staticID(const BinaryFunction &BF) const;
+
+  const char *getName() const override { return "replace-memalloc"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
+/// PreFix: repoint every free() call to free_wrapper (--replace-free).
+class ReplaceFree : public BinaryFunctionPass {
+private:
+  std::vector<std::string> Spec;
+
+public:
+  explicit ReplaceFree(const cl::opt<bool> &PrintPass,
+                       cl::list<std::string> &Spec)
+      : BinaryFunctionPass(PrintPass), Spec(Spec) {}
+
+  const char *getName() const override { return "replace-free"; }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
+
